+                # RWKV-7 overlay (F0078 follow-up), env-gated, default OFF. The
+                # speculative verify path needs row m of an M-row projection to be
+                # bit-identical to the M=1 projection plain decode uses, and cuBLAS
+                # does not promise that across M -- so rwkv_spec_worker recomputes
+                # the whole thing one row at a time, re-reading a 512 MiB weight per
+                # row (measured 1.9 ms/round at M=6, and it grows linearly with the
+                # batch). Routing BOTH paths through the shared-weight GEMV makes the
+                # invariance structural at one weight pass. Both sides must move
+                # together or they disagree; hence one flag, here, not in the worker.
+                _fast_lm = os.environ.get("RWKV_FAST_LMHEAD", "0") == "1"
+                _w = lm_head.weight
+                if (
+                    _fast_lm
+                    and _w.dtype == torch.float16
+                    and hidden_states.dtype == torch.float16
+                    and _w.is_contiguous()
+                    and (_w.shape[0] % 2) == 0
+                    and (_w.shape[1] % 4) == 0
+                    and hidden_states.dim() == 2
+                ):
+                    from sglang.srt.layers.attention.rwkv7_kernels import fast_linear
+
+                    # M<=8 ONLY. Above that the shared-weight variant does not apply
+                    # and chunking loses badly to a real GEMM, which reads the weight
+                    # once for ALL rows: measured on the 7.2B head (65536x4096),
+                    # cuBLAS vs chunked is 0.345 vs 2.593 ms at M=64 and 0.812 vs
+                    # 12.968 ms at M=320. The win here was never "our kernel beats
+                    # cuBLAS" -- at M<=8 they are within 2% -- it is "one call instead
+                    # of M", so it only exists where the alternative was M calls.
+                    # Large-batch decode keeps the GEMM it always had.
+                    if fast_linear.available() and hidden_states.shape[0] <= 8:
+                        logits = fast_linear.gemv_mb(hidden_states, _w)
+                    else:
+                        logits = torch.matmul(
+                            hidden_states.to(_w.dtype), _w.T
+                        )
+                else:
+                    logits = torch.matmul(
+                        hidden_states.to(lm_head.weight.dtype), lm_head.weight.T
+                    )
         else:
